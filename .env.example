# =====================================================================
# Perk development environment. Copy to .env.dev and fill it in; .env.* is gitignored.
# Usage: scripts/with-env.sh forge test    or    set -a; source .env.dev; set +a
# =====================================================================

# [required] Alchemy API key. Mainnet, testnet, fork tests and the indexer's historical queries all share it.
#            foundry.toml builds the RPC URL: https://xlayer-{mainnet,testnet}.g.alchemy.com/v2/<key>
ALCHEMY_API_KEY=

# [required to deploy] Deployment private key. A development account on testnet; mainnet deploys go through a
#                      multisig and do not use this variable.
DEPLOYER_PRIVATE_KEY=

# ---------- everything below has a default and rarely needs changing ----------
# Pin fork tests to a block; empty means latest
XLAYER_FORK_BLOCK=
# OKLink verification needs no account, so any value works
XLAYER_EXPLORER_API_KEY=xxxx
# Community Treasury migration timelock, in seconds
TREASURY_TIMELOCK_SECONDS=172800
# Vault-level LP Grant parameters (ADR-008). The defaults are shown; normally leave them unset.
# GRANT_ROOT_DELAY_SECONDS=86400
# GRANT_ROOT_DEADLINE_SECONDS=1209600
# GRANT_MIN_ACTIVATION=1000000000000000000
# GRANT_EXCESS_TO_INCENTIVE_BPS=10000
# Grant publisher: the automated key that may propose and cancel grant roots and nothing else. ConfigurePerk
# appoints it on the vault; empty leaves publishing to the owner. The demo driver uses mnemonic index 40.
# GRANT_PUBLISHER=
# Delay between proposing and executing the rescue of a stuck graduation (at least one hour; default 3 days)
# GRAD_RESCUE_DELAY_SECONDS=259200
# Administrative addresses; empty means the deployer
PROTOCOL_OWNER=
PROTOCOL_FEE_RECIPIENT=
# Mainnet XDOG address, set before a mainnet deploy. Testnet has no XDOG, so the script deploys a mock.
XDOG_TOKEN_ADDRESS=
# The testnet has no official Uniswap v4. It currently uses FlapVenue's deployment, which provides only a
# PoolManager and a test router; our deploy script adds a PositionManager on top of it. Clear POOL_MANAGER and the
# script deploys the whole set itself.
V4_TESTNET_POOL_MANAGER=0xd44387034102491Af58292fF1c7405AED4e7Eb04
V4_TESTNET_POSITION_MANAGER=
V4_TESTNET_SWAP_ROUTER=0xB59271CD9158Bb50125c3F9AC5CA013eE2fa7AF6

# ---------- accelerated testnet timings (optional; mainnet scripts ignore them) ----------
# ConfigureTestnetTemplates.s.sol registers an extra fast template from these; the smoke and lifecycle scripts
# select it with TEST_TEMPLATE. Keep accelerated timing here, never in contract logic.
# GRANT_ROOT_DELAY_SECONDS=3600
# GRANT_ROOT_DEADLINE_SECONDS=7200
# TEST_TEMPLATE=TEST_FAST_V1
# TEST_CURVE_SCALE_DIV=10000
# TEST_GRANT_WINDOW_SECONDS=7200
# TEST_MIN_LP_SECONDS=600
# GRAD_RESCUE_DELAY_SECONDS=3600

# ---------- RPC for the indexer, the demo driver and the snapshot tool ----------
# Empty means Alchemy (from ALCHEMY_API_KEY). The public X Layer endpoints need no key but serve eth_getLogs at most
# 100 blocks at a time, so set LOG_PAGE=100 with them (Alchemy allows 1000, the default).
# RPC_URL=https://testrpc.xlayer.tech
# LOG_PAGE=100
# Role-wallet mnemonic; scripts/testnet-roles.sh generates one on first run and appends it to .env.dev
# TEST_MNEMONIC=
