# Perk API / indexer. Copy to .env (gitignored) or export in the shell.
# Postgres (local dev: brew postgresql@16, db created with `createdb perk_dev`)
DATABASE_URL=postgres://localhost:5432/perk_dev
# Chain to index: 1952 (X Layer testnet) or 196 (mainnet)
CHAIN_ID=1952
# Server-side RPC. Never ships to the browser. Alchemy: https://xlayer-testnet.g.alchemy.com/v2/<key>
RPC_URL=https://testrpc.xlayer.tech
# Blocks behind head the indexer stays (reorg safety). 0 = index the head.
CONFIRMATIONS=2
# Live mode: one head poll per POLL_MS (ms). Only new blocks are fetched; an idle poll is a single eth_blockNumber.
POLL_MS=1500
# Lag (blocks) above which the indexer switches to catch-up: 1000-block windows back to back, no sleep
CATCHUP_BLOCKS=200
# Max blocks per eth_getLogs (Alchemy caps X Layer at 1000)
LOG_PAGE=1000
# HTTP port for the read API
PORT=8787
# Admin roles are not configured here: the Core Admin and Grant Admin are read from the chain (contract owner,
# grant vault publisher) and General Admins are added by the Core Admin on the site's admin page.
# Comma-separated origins allowed by CORS (dev default allows http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
# Token media: local disk (default) or Pinata IPFS. pinata requires PINATA_JWT (never log it).
MEDIA_DRIVER=local
MEDIA_DIR=./data/media
# Origin baked into local media URLs (tokenURI). Defaults to http://localhost:$PORT
PUBLIC_API_URL=http://localhost:8787
# Pinata JWT for MEDIA_DRIVER=pinata (a key with the Files API upload scope). Leave unset for local.
# Anything launched on the testnet or mainnet needs pinata: a token's on-chain link cannot change, so its image
# must live somewhere permanent and public, not on this server's disk.
PINATA_JWT=
# Gateway prefix used to rewrite ipfs:// CIDs into browser URLs (include trailing slash)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# POST /v1/media/* per-IP token bucket (capacity / window)
MEDIA_RATE_LIMIT=20
MEDIA_RATE_WINDOW_MS=600000
# Set true ONLY behind a reverse proxy that appends to X-Forwarded-For (DigitalOcean App Platform does). Left false,
# clients cannot spoof their rate-limit identity by sending the header themselves.
TRUST_PROXY=false
# With TRUST_PROXY=true: how many proxies sit in front of the API. The client is the entry this many places from the
# right of X-Forwarded-For. Defaults to 1 when TRUST_PROXY=true, else 0.
# TRUSTED_PROXY_HOPS=1
# Daily byte budget for uploads across all clients (default 256 MiB)
# MEDIA_DAILY_UPLOAD_BYTES=268435456
# WebSocket connections one client address may hold (IPv6 counted per /64)
# WS_MAX_CLIENTS_PER_IP=20
# Read file:// grant dataset URIs: local development only, refused on chain 196
# ALLOW_FILE_DATASET_URIS=false
# IPv4 ranges outbound fetches (token metadata, grant datasets) accept besides public addresses, for a development
# machine behind a proxy that answers DNS with "fake IPs"; local development only, refused on chain 196
# FETCH_ALLOW_RANGES=198.18.0.0/15
# USD prices for quote assets, JSON merged over the defaults. Keys: "native", a quote address or a symbol; values:
# okx:<instId>, cnbc:<TICKER>, nasdaq:<TICKER>, fixed:<number> or none. Defaults: native OKB -> okx:OKB-USDT,
# tokenised stocks ("t" + a US ticker, e.g. tAAPL) -> cnbc:<TICKER>.
# PRICE_SOURCES={"tAAPL":"cnbc:AAPL"}
# Largest request body the server will read, in bytes (media uploads are the only POSTs)
MAX_BODY_BYTES=3145728
