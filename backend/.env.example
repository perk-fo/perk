# Perk API / indexer. Copy to .env (gitignored) or export in the shell.
# Postgres (local dev: brew postgresql@16, db created with `createdb perk_dev`)
DATABASE_URL=postgres://localhost:5432/perk_dev
# Chain to index: 1952 (X Layer testnet) or 196 (mainnet)
CHAIN_ID=1952
# Server-side RPC. Never ships to the browser. Alchemy: https://xlayer-testnet.g.alchemy.com/v2/<key>
RPC_URL=https://testrpc.xlayer.tech
# Blocks behind head the indexer stays (reorg safety). 0 = index the head.
CONFIRMATIONS=2
# Live mode: one head poll per POLL_MS (ms). Only new blocks are fetched; an idle poll is a single eth_blockNumber.
POLL_MS=1500
# Lag (blocks) above which the indexer switches to catch-up: 1000-block windows back to back, no sleep
CATCHUP_BLOCKS=200
# Max blocks per eth_getLogs (Alchemy caps X Layer at 1000)
LOG_PAGE=1000
# HTTP port for the read API
PORT=8787
# Comma-separated extra admin wallets (protocolOwner + deployer from deployments JSON are always admins)
ADMIN_ADDRESSES=
# Comma-separated origins allowed by CORS (dev default allows http://localhost:3000)
CORS_ORIGINS=http://localhost:3000
# Token media: local disk (default) or Pinata IPFS. pinata requires PINATA_JWT (never log it).
MEDIA_DRIVER=local
MEDIA_DIR=./data/media
# Origin baked into local media URLs (tokenURI). Defaults to http://localhost:$PORT
PUBLIC_API_URL=http://localhost:8787
# Pinata JWT for MEDIA_DRIVER=pinata. Leave unset for local.
PINATA_JWT=
# Gateway prefix used to rewrite ipfs:// CIDs into browser URLs (include trailing slash)
IPFS_GATEWAY=https://ipfs.io/ipfs/
# POST /v1/media/* per-IP token bucket (capacity / window)
MEDIA_RATE_LIMIT=20
MEDIA_RATE_WINDOW_MS=600000
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For. Left false, clients cannot spoof their
# rate-limit identity by sending the header themselves.
TRUST_PROXY=false
# Largest request body the server will read, in bytes (media uploads are the only POSTs)
MAX_BODY_BYTES=3145728
