# @perk/api base URL (the browser reads lists, charts and histories from it; ADR-010)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional overrides of the public X Layer RPCs used for per-user eth_calls. No API keys here, ever.
# NEXT_PUBLIC_RPC_TESTNET=https://testrpc.xlayer.tech
# NEXT_PUBLIC_RPC_MAINNET=https://rpc.xlayer.tech

# FlapVenue PoolSwapTest router on X Layer testnet (chain 1952). Mainnet swaps are out of scope.
NEXT_PUBLIC_TESTNET_SWAP_ROUTER=0xB59271CD9158Bb50125c3F9AC5CA013eE2fa7AF6
